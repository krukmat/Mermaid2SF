flowchart TD
    Start([START: Create Account Flow\nflow: autolaunched\nvariable: accountName String])
    Assign[ASSIGNMENT: Set Account Values\nset: accountName = "Demo Account"]
    Create[CREATE: Create Account Record\nobject: Account\nfield: Name = {!accountName}]
    End([END: Account Created])

    Start --> Assign
    Assign --> Create
    Create --> End
