<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <environments>Default</environments>
    <interviewLabel>Golden Record Triggered After Save Rich {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Golden Record Triggered After Save Rich</label>
