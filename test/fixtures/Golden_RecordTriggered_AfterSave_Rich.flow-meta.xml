        <defaultConnectorLabel>Create Contact</defaultConnectorLabel>
        <rules>
            <name>Named_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Acme</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account</targetReference>
            </connector>
            <label>Named Account</label>
        </rules>
    </decisions>
    <recordLookups>
