            <name>accountId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>result</assignToReference>
            <name>childResult</name>
        </outputAssignments>
    </subflows>
