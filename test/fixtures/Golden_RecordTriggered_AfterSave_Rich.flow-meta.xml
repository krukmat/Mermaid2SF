    <assignments>
        <name>Capture_Record</name>
        <label>Capture Record</label>
        <locationX>0</locationX>
        <locationY>100</locationY>
        <assignmentItems>
            <assignToReference>recordId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Route_Account</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Route_Account</name>
        <label>Route Account</label>
        <locationX>0</locationX>
        <locationY>200</locationY>
